PORT=1986
SOCKET_PORT=1992

DIRECTLINE_HOST='localhost.home'
DIRECTLINE_REGION='eu'
DIRECTLINE_SOCKET_URL='wss://localhost:home'

JWT_EXPIRATION_SECONDS=3600
JWT_SECRET='safe-256-bit'
ADMIN_USERNAME='admin'
ADMIN_PASSWORD='$2b$10$tB8AmTuUk2M8yiCz89qVmeadSS9o851a9TTCgExZppA7Q9Soe/8uC'

# MySQL options
TYPEORM_CONNECTION='postgres'
TYPEORM_HOST='localhost'
TYPEORM_PORT=5432
TYPEORM_USERNAME='postgres'
TYPEORM_PASSWORD=''
TYPEORM_DATABASE='obf'
TYPEORM_ENTITIES='dist/**/*.entity.js'
TYPEORM_MIGRATIONS='dist/migrations/*.js'
TYPEORM_MIGRATIONS_DIR='migrations'
TYPEORM_AUTORUN_MIGRATIONS=true

# Storage (S3, Minio, Wasabi, DigitalOcean etc)
STORAGE_ACCESS_KEY=''
STORAGE_SECRET_KEY=''
STORAGE_BUCKET=''
STORAGE_REGION_S3='us-east-1' # Specific to S3.
STORAGE_FORCE_S3_PATH_STYLE=true
# STORAGE_ENDPOINT='' # S3 endpoint

# Redis
REDIS_URI='redis://localhost:6379'

# Atomic Operations
ATOMIC_OPERATIONS_IMPLEMENTATION='redis' # memory | redis, falls back to memory if redis not available

# Proxies in front of OBF. Client IP comes from X-Forwarded-For (0 when exposed directly)
TRUST_PROXY_HOPS=1

# Rate limits, per minute
RATE_LIMIT_TOKENS_PER_MINUTE=30 # per client IP: token generate/refresh and new conversations
RATE_LIMIT_MESSAGES_PER_MINUTE=20 # per conversation
RATE_LIMIT_UPLOADS_PER_MINUTE=5 # per conversation

# Uploads
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_FILES=5
